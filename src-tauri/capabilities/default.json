{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main","mini-player"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-maximized",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-decorations",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-open",
    "dialog:allow-message",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:webview:allow-create-webview-window",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-cursor-position",
    "core:window:allow-set-cursor-icon",
    "core:window:allow-set-ignore-cursor-events"
  ],
  "allowlist": {
    "shell": {
      "all": false,
      "open": true
    }
  },
  "remote": {
    "urls": [
      "https://**",
      "http://localhost/**",
      "http://localhost:*/*",
      "http://127.0.0.1/**",
      "http://127.0.0.1:*/*"
    ]
  },
  "command": {
    "allow": [
      "greet",
      "quit_app",
      "frontend_log",
      "app_setting_get",
      "app_setting_set",
      "app_setting_remove",
      "app_settings_clear",
      "cache_get",
      "cache_set",
      "cache_stats",
      "cache_set_max_bytes",
      "cache_clear",
      "local_audio_scan",
      "local_audio_read",
      "fetch_audio_bytes",
      "fetch_audio_source",
      "fetch_youtube_music_audio",
      "proxy_http_request",
      "update_macos_media_session",
      "update_windows_media_session",
      "update_linux_media_session",
      "save_youtube_credentials",
      "load_youtube_credentials",
      "delete_youtube_credentials",
      "load_youtube_music_cookie",
      "sign_in_youtube_music",
      "delete_youtube_music_cookie",
      "lastfm_auth_token",
      "lastfm_complete_auth",
      "lastfm_disconnect",
      "lastfm_get_session",
      "lastfm_scrobble",
      "lastfm_update_now_playing"
    ]
  }
}
